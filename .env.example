# Modèle de configuration : copier en .env (ou lancer bash scripts/init-env.sh qui génère les mots de passe)
# Le fichier .env contient des secrets : il est ignoré par git.

# Compte administrateur de GeoServer (http://localhost:8096/geoserver/web/)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=a_changer

# Rôle PostgreSQL en lecture seule utilisé par GeoServer pour lire PostGIS
PG_GEOSERVER_USER=geoserver
PG_GEOSERVER_PASSWORD=a_changer
